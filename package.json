{
  "name": "superjsonld",
  "version": "0.2.0",
  "description": "Tiny, configurable JSON-LD (schema.org) builders for the web, with an optional React component. Framework-agnostic core, typed with schema-dts.",
  "keywords": [
    "json-ld",
    "jsonld",
    "schema.org",
    "schema-dts",
    "structured-data",
    "seo",
    "rich-results",
    "react",
    "nextjs"
  ],
  "license": "MIT",
  "author": "Thiago",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagosouza/superjsonld.git"
  },
  "homepage": "https://github.com/thiagosouza/superjsonld#readme",
  "bugs": {
    "url": "https://github.com/thiagosouza/superjsonld/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "pnpm build",
    "release": "changeset publish"
  },
  "dependencies": {
    "schema-dts": "^1.1.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/cli": "^2.29.7",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=18"
  }
}
